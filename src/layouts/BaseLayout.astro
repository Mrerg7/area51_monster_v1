---
const {
  title = 'AREA 51 — Alien & Spaceship Storage | Nevada Desert',
  description = 'Deep beneath the Nevada desert lies the most classified real estate on Earth. Alien spacecraft hangars, subterranean tunnels leading to the Pacific. Area 51 holds the story of the century — available for acquisition, film, or development.',
  ogImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/5a039890-c1aa-49c4-f98e-46aad2763e00/public',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="r6-gXeZicxeh8P5nBmttj3RfU9Dze3Rpi496nVff_iY" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="AREA 51" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AREA 51 — Alien & Spaceship Storage",
    "url": "https://area51.monster/",
    "description": "Deep beneath the Nevada desert lies the most classified real estate on Earth. Alien spacecraft storage, subterranean tunnels, and an unclassified story available for acquisition or film development.",
    "potentialAction": {
      "@type": "ContactAction",
      "name": "Domain & Story Acquisition",
      "target": "mailto:sales@desertrich.com"
    }
  }
  </script>

  <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    :root {
      --green: #00ff41;
      --dim-green: #00aa2b;
      --black: #000000;
      --near-black: #080808;
      --grey: #1a1a1a;
      --text: #b0b0b0;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--black);
      color: var(--text);
      font-family: 'Courier New', Courier, monospace;
      overflow-x: hidden;
    }
    a { color: var(--green); text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
